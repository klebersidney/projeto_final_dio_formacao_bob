{
  "name": "geo-explorer-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server para o Projeto Final DIO – expõe trilhas, desafios e certificados via Model Context Protocol (stdio, HTTP/SSE)",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "geo-explorer-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "start:http": "node build/http-server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
